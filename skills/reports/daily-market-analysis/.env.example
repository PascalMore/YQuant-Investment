# daily-market-analysis 环境变量模板
# 复制为 .env 后填入真实值；.env 已被 .gitignore，不会入仓库。
#
# 加载顺序: 系统环境变量优先于 .env（load_dotenv(override=False)），
# 共享 loader 见 src/config.py::load_skill_config()。

# Tavily：AI 新闻搜索（免费 1000 次/月）
# 申请: https://app.tavily.com/
TAVILY_API_KEY=

# GNews：全球新闻 API（免费 100 次/天）
# 申请: https://gnews.io/
GNEWS_API_KEY=

# TradingEconomics：全球经济日历（免费基础版）
# 申请: https://tradingeconomics.com/api
TRADING_ECONOMICS_API_KEY=

# QQ SMTP 发件账号
EMAIL_USERNAME=

# QQ SMTP 授权码（非登录密码）
EMAIL_PASSWORD=

# 收件人列表（英文逗号分隔）
EMAIL_RECIPIENTS=